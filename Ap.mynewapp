import streamlit as st
import pywhatkit

st.set_page_config(page_title="واتساب بوت", page_icon="📱")

st.title("واتساب بوت برو")
st.write("ابعت رسايل واتساب أوتوماتيك من أي مكان!")

رقم = st.text_input("الرقم مع كود الدولة", placeholder="+201234567890")
رسالة = st.text_area("الرسالة", height=150)

if st.button("إرسال الرسالة", use_container_width=True):
    if not رقم or not رسالة:
        st.error("اكتب الرقم والرسالة!")
    elif not رقم.startswith('+'):
        st.error("الرقم لازم يبدأ بـ +20")
    else:
        with st.spinner("جاري الإرسال..."):
            try:
                pywhatkit.sendwhatmsg_instantly(رقم, رسالة, wait_time=15, tab_close=True, close_time=5)
                st.success(f"تم الإرسال إلى {رقم} ✅")
                st.balloons()
            except:
                st.error("حصل خطأ، جرب تاني")
